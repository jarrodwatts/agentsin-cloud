{
  "name": "@agentsin-cloud/worker",
  "version": "0.0.1",
  "private": true,
  "bin": {
    "agentsin-cloud-worker": "./dist/entrypoint.mjs"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./t3-provider": {
      "types": "./src/T3ProviderRuntime.ts",
      "import": "./src/T3ProviderRuntime.ts"
    }
  },
  "scripts": {
    "build": "vp pack src/entrypoint.ts --out-dir dist && vp pack src/ProviderRuntimeChild.ts --out-dir dist --no-clean && vp pack src/imageCanaryEntrypoint.ts --out-dir dist --no-clean && node --experimental-strip-types ./scripts/prepare-image-assets.ts && node ./dist/imageCanaryEntrypoint.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "effect": "catalog:",
    "node-pty": "^1.1.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "8.18.1",
    "@typescript/native-preview": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.13.1"
  }
}
